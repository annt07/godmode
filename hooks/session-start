#!/usr/bin/env bash
# SessionStart hook for godmode plugin
# Injects using-godmode bootstrap content into the agent's context at session start,
# so the agent loads the full skill catalog automatically without being told to.

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-godmode content (lives under skills/ subdirectory)
using_godmode_content=$(cat "${PLUGIN_ROOT}/skills/using-godmode/SKILL.md" 2>&1 || echo "Error reading using-godmode skill")

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_godmode_escaped=$(escape_for_json "$using_godmode_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have godmode skills active.\n\n**Below is the full content of your 'godmode:using-godmode' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_godmode_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON.
# Different harnesses use different field names for the additional context:
#   Cursor:      additional_context (snake_case, top-level)
#   Claude Code: hookSpecificOutput.additionalContext (nested)
#   Muse:        hookSpecificOutput.additionalContext (nested, Muse Spark)
#   Copilot CLI / others: additionalContext (top-level, SDK standard)
#
# Uses printf instead of heredoc to avoid bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
